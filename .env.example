# Salin ke ".env" (JANGAN di-commit). Semua nilai di sini RAHASIA kecuali SUPABASE_URL.
SUPABASE_URL=https://smrrtewmwporecppofkj.supabase.co
# Dashboard Supabase > Settings > API Keys > service_role / secret. Hanya untuk skrip di komputer/server Anda, tidak pernah di frontend.
SUPABASE_SERVICE_KEY=
# Opsional. "none" = tanpa AI (hanya JSON-LD atau input JSON manual). "gemini" = Google AI Studio free tier.
AI_PROVIDER=none
GEMINI_API_KEY=
# Isi dengan model yang tertera GRATIS di Google AI Studio saat ini (kuota dan nama model sering berubah).
AI_MODEL=
AI_DELAY_MS=7000
# Identitas bot; sebaiknya cantumkan kontak Anda.
BOT_UA=JobFinderBot/0.1 (+email-anda@contoh.com)
